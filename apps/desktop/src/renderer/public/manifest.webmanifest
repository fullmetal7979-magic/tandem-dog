{
  "id": "/",
  "name": "COSMOS 코스모스",
  "short_name": "코스모스",
  "description": "어느 기기에서든 같은 세션으로 이어 쓰는 코스모스 개발 도구",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#151518",
  "theme_color": "#151518",
  "icons": [
    {
      "src": "/mixdog-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/mixdog-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/mixdog.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf", "text/*"]
        }
      ]
    }
  }
}
